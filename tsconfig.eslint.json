{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "tsdown.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
